{
  "name": "@contrail/desktop",
  "version": "0.15.0",
  "description": "Contrail — the Salesforce AI harness. Desktop app.",
  "author": "Ryley Hayes",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "smoke": "electron-vite build && electron . --smoke",
    "pack:dir": "electron-builder --dir --win",
    "pack:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@contrail/agent-runtime": "workspace:*",
    "@contrail/engine": "workspace:*",
    "@contrail/shared": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.15",
    "@contrail/skills": "workspace:*",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^3.0.0"
  }
}
