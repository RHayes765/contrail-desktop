node_modules/
dist/
# The unanchored dist/ above matches ANY depth — without this negation it
# silently eats the vendored apex-ls bundles (from git add, and from CI's
# clean checkout), shipping every release broken with zero errors.
!packages/apex-ls/vendor/apex-ls/dist/
dist-electron/
out/
release/
*.log
.DS_Store
*.tsbuildinfo
coverage/
.secrets/

# local diagnostic outputs
*-diag.json

# packaged output
apps/desktop/release/
apps/desktop/release2/
